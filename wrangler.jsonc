{
  "name": "ebdroom",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "CAPTCHA_KV",
      "id": "d8d7d8446c9e46519590c8e41a1b367a"
    }
  ]
}
